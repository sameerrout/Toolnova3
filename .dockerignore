# Build output and dependencies. Everything here is regenerated by the build, and
# copying node_modules into the image would both bloat it and break native binaries.
node_modules
.next
out
coverage
.npm-cache

# Version control and editors
.git
.gitignore
.github
.vscode
.idea

# Local configuration and secrets. NEXT_PUBLIC_* values are passed as build args
# instead, so that a stray .env cannot leak into the image.
.env
.env.*
!.env.example
deploy/.env.deploy

# Documentation and deployment tooling: not needed at runtime
*.md
!README.md
deploy
tests
vitest.config.ts
eslint.config.mjs

# OS noise
.DS_Store
Thumbs.db
*.log
