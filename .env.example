# ============================================================
# TOOLNOVA CONFIGURATION SPECIFICATION (.env.example)
# ============================================================

# Web Application Host & URLs
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://toolnova.com

# Server Python Runtime & Worker Management (§23, §55)
# Specify the path to your Python interpreter (e.g., 'python', 'py', or '/usr/bin/python3')
TOOLNOVA_PYTHON_BIN=python

# Storage & Memory Architecture (§9, §14, §21)
# Base storage directory for isolated temporary jobs
TOOLNOVA_TEMP_DIR=
# Hours to retain completed/failed output files before automatic garbage collection
TOOLNOVA_JOB_RETENTION_HOURS=1
# Maximum processing time per job in seconds
TOOLNOVA_JOB_TIMEOUT_SECONDS=600

# Concurrency & Resource Limits (§5, §11, §28)
# Maximum worker concurrency (0 = auto-calculate from available CPU cores and RAM)
TOOLNOVA_MAX_WORKERS=0
# Server RAM safety reserve in megabytes that workers may not consume
TOOLNOVA_SAFETY_RESERVE_MB=512
# Hard upload size limit in megabytes
TOOLNOVA_MAX_FILE_MB=100
# Maximum allowed page count for complex document transformations
TOOLNOVA_MAX_PAGES=500
# Chunk size (pages per batch) for large PDF to DOCX conversions
TOOLNOVA_PDF2DOCX_CHUNK_SIZE=15

# Optional Document Engine Binaries (§14, §16, §55)
# Explicit path to LibreOffice/soffice executable (if not in system PATH)
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Linux example: /usr/bin/soffice
LIBREOFFICE_PATH=

# Optional Local OCR Engine Binary (§12)
# Explicit path to Tesseract OCR executable (if not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TOOLNOVA_OCR_PATH=
