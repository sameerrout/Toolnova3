# ============================================================
# Toolnova environment configuration
# ============================================================
# Copy this file to `.env.local` for local development.
#
# Only three variables exist on purpose. Toolnova has no server-side
# processing, no database, no auth, and no job queue, so there is nothing else
# to configure. Everything below is inlined into the static build at build time
# (they are all `NEXT_PUBLIC_*`), which is why they must never hold a secret.

# Canonical public origin, used for canonical tags, sitemap.xml, robots.txt,
# Open Graph URLs and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://toolnova.com

# Google AdSense publisher id. Leave empty to disable ads entirely: when this is
# empty no AdSense script is requested and <AdSlot /> renders nothing.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Optional: fully self-hosted OCR + background-removal model assets
# ---------------------------------------------------------------------------
# By default Tesseract language data and the background-removal ONNX models are
# fetched on demand from public CDNs the first time those two tools are used,
# and then cached by the browser. Your FILES are never uploaded - only the
# model weights are downloaded.
#
# To serve them from your own bucket instead, run:
#   node scripts/vendor-models.mjs
# and set these to your own origin (see README "Self-hosting model assets").
NEXT_PUBLIC_OCR_ASSET_BASE=
NEXT_PUBLIC_BG_REMOVAL_ASSET_BASE=
